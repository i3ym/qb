<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    
    <!-- This currently causes random lockups during gameplay. https://github.com/mono/mono/issues/18973 -->
    <EnableLLVM>false</EnableLLVM>

    <ApplicationVersion>56</ApplicationVersion>
    <Version>1.0.0-of</Version>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    
    <JavaSdkDirectory>/usr/lib/jvm/java-21-openjdk</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.osu.Framework.Android" Version="2026.513.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\qb\qb.csproj" />
  </ItemGroup>
</Project>
